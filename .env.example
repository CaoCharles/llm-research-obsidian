# ==========================================================
# llm-paper-obsidian environment template
# Copy to .env and fill with your real values.
# ==========================================================

# --- Core (LPDD, scripts, benchmark notebooks) ---
# Required for lpdd pipeline and evaluation notebooks.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: if using OpenAI-compatible endpoint/proxy.
# Prefer OPENAI_BASE_URL for modern SDKs.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_BASE=https://api.openai.com/v1

# Optional: defaults to repo root when not set.
# Example:
# OBSIDIAN_VAULT_PATH=/Users/yourname/path/to/llm-paper-obsidian
OBSIDIAN_VAULT_PATH=

# --- Backend chatbot service (FastAPI + Gemini) ---
# Required only if you run backend/chat_server.py.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional for local backend run (Railway will inject PORT automatically).
PORT=8000
